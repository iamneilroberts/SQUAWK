# adsb-game backend configuration — copy to .env and adjust.
# No secrets are required; every upstream is keyless.

# Where the backend listens
ADSB_GAME_HOST=127.0.0.1
ADSB_GAME_PORT=8010

# Default home location for the browse screen (Mobile, AL)
HOME_LAT=30.6944
HOME_LON=-88.0399

# ADS-B feeds, in failover order (readsb/tar1090 schema). Full URL templates, not bases -
# upstream path shapes differ per feed ({lat}/{lon}/{radius} placeholders, see G-005).
FEED_PRIMARY=https://api.airplanes.live/v2/point/{lat}/{lon}/{radius}
FEED_FALLBACK=https://api.adsb.lol/v2/lat/{lat}/lon/{lon}/dist/{radius}
FEED_RESERVE=https://opendata.adsb.fi/api/v2/lat/{lat}/lon/{lon}/dist/{radius}

# adsbdb, for type -> flight-model class mapping
ADSBDB_BASE=https://api.adsbdb.com/v0

# Minimum seconds between upstream ADS-B requests (feed courtesy limit)
FEED_MIN_INTERVAL_S=1.0
