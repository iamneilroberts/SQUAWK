# adsb-game backend configuration — copy to .env and adjust.
# No secrets are required; every upstream is keyless.
#
# NOTE: the Cloudflare Worker install path is configured separately via
# frontend/wrangler.jsonc + frontend/.dev.vars (see README "Cloudflare Worker").

# Where the backend listens
ADSB_GAME_HOST=127.0.0.1
ADSB_GAME_PORT=8020

# Default home location for the browse screen (Mobile, AL)
HOME_LAT=30.6944
HOME_LON=-88.0399

# ADS-B feeds, in failover order (readsb/tar1090 schema). Full URL templates, not bases -
# upstream path shapes differ per feed ({lat}/{lon}/{radius} placeholders, see G-005).
FEED_PRIMARY=https://api.airplanes.live/v2/point/{lat}/{lon}/{radius}
FEED_FALLBACK=https://api.adsb.lol/v2/lat/{lat}/lon/{lon}/dist/{radius}
FEED_RESERVE=https://opendata.adsb.fi/api/v2/lat/{lat}/lon/{lon}/dist/{radius}

# adsbdb, for type -> flight-model class mapping
ADSBDB_BASE=https://api.adsbdb.com/v0

# NOAA Aviation Weather Center METAR API (keyless), for the weather panel's nearest-station
# report. The backend appends ?ids={ICAO}&format=json.
METAR_BASE=https://aviationweather.gov/api/data/metar

# Minimum seconds between upstream ADS-B requests (feed courtesy limit)
FEED_MIN_INTERVAL_S=1.0

# Optional. Terrain falls back to Cesium ion world terrain if Re:Earth is unreachable AND
# this token is set. Leave it empty to stay fully keyless — the fallback is then a flat
# ellipsoid, honestly labelled in the status bar. Cesium ion's free tier is non-commercial.
VITE_CESIUM_ION_TOKEN=

# Optional: public hostname when exposing the dev server through a reverse proxy or
# Cloudflare tunnel (Vite 5.4.12+ blocks unknown Host headers by default).
# ADSB_GAME_PUBLIC_HOST=game.example.com
