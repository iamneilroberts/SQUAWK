{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voygent-adsb-game",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-08",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/admin*"]
  },
  "vars": {
    "APP_ENV": "local",
    "FORCE_MODE": "NORMAL",
    "AUTH_FROM_EMAIL": "sign-in@fly.voygent.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voygent-adsb-game-local",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_REQUEST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ADSB_BROKER",
        "class_name": "AdsbBroker"
      }
    ]
  },
  "exports": {
    "AdsbBroker": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "REQUEST_ANALYTICS",
      "dataset": "voygent_adsb_game_requests_local"
    }
  ],
  "send_email": [
    {
      "name": "AUTH_EMAIL"
    },
    {
      "name": "ALERT_EMAIL",
      "destination_address": "dneilroberts@gmail.com"
    }
  ],
  "env": {
    "staging": {
      "vars": {
        "APP_ENV": "staging",
        "FORCE_MODE": "NORMAL",
        "AUTH_FROM_EMAIL": "sign-in@fly.voygent.app",
        "PUBLIC_ORIGIN": "https://voygent-adsb-game-staging.somotravel.workers.dev",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEMNrkMteVREAOpe"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "voygent-adsb-game-staging",
          "database_id": "c2de68eb-4b51-4e79-b453-92a2df0c4f29",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "AUTH_REQUEST_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ADSB_BROKER",
            "class_name": "AdsbBroker"
          }
        ]
      },
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_ANALYTICS",
          "dataset": "voygent_adsb_game_requests_staging"
        }
      ],
      "send_email": [
        {
          "name": "AUTH_EMAIL"
        },
        {
          "name": "ALERT_EMAIL",
          "destination_address": "dneilroberts@gmail.com"
        }
      ]
    },
    "production": {
      "vars": {
        "APP_ENV": "production",
        "FORCE_MODE": "NORMAL",
        "AUTH_FROM_EMAIL": "sign-in@fly.voygent.app",
        "PUBLIC_ORIGIN": "https://fly.voygent.app"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "voygent-adsb-game-production",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "AUTH_REQUEST_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ADSB_BROKER",
            "class_name": "AdsbBroker"
          }
        ]
      },
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_ANALYTICS",
          "dataset": "voygent_adsb_game_requests_production"
        }
      ],
      "send_email": [
        {
          "name": "AUTH_EMAIL"
        },
        {
          "name": "ALERT_EMAIL",
          "destination_address": "dneilroberts@gmail.com"
        }
      ]
    }
  }
}
