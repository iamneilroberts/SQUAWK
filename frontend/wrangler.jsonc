{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voygent-adsb-game",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-08",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/admin*"]
  },
  "vars": {
    "APP_ENV": "local"
  },
  "analytics_engine_datasets": [
    {
      "binding": "REQUEST_ANALYTICS",
      "dataset": "voygent_adsb_game_requests_local"
    }
  ],
  "send_email": [
    {
      "name": "AUTH_EMAIL"
    },
    {
      "name": "ALERT_EMAIL",
      "destination_address": "dneilroberts@gmail.com"
    }
  ],
  "env": {
    "staging": {
      "vars": {
        "APP_ENV": "staging"
      },
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_ANALYTICS",
          "dataset": "voygent_adsb_game_requests_staging"
        }
      ],
      "send_email": [
        {
          "name": "AUTH_EMAIL"
        },
        {
          "name": "ALERT_EMAIL",
          "destination_address": "dneilroberts@gmail.com"
        }
      ]
    },
    "production": {
      "vars": {
        "APP_ENV": "production"
      },
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_ANALYTICS",
          "dataset": "voygent_adsb_game_requests_production"
        }
      ],
      "send_email": [
        {
          "name": "AUTH_EMAIL"
        },
        {
          "name": "ALERT_EMAIL",
          "destination_address": "dneilroberts@gmail.com"
        }
      ]
    }
  }
}
