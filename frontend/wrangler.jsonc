{
  // SQUAWK — neutral public template. Copy this to wrangler.prod.jsonc (gitignored)
  // and replace every <PUT_YOUR_...>, your-domain.example, and your-team value with
  // your own before deploying. `npm run deploy:production` / `deploy:staging` use the
  // overlay, not this file. This file is what local dev (`npm run dev:worker`) reads.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "squawk",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-08",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/admin*"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_ENV": "local",
    "FORCE_MODE": "NORMAL",
    "AUTH_FROM_EMAIL": "sign-in@your-domain.example",
    "ALERT_FROM_EMAIL": "alerts@your-domain.example",
    "ADMIN_EMAIL": "admin@your-domain.example",
    "ALERT_RECIPIENT": "<PUT_YOUR_ALERT_INBOX>",
    "CLOUDFLARE_ACCOUNT_ID": "<PUT_YOUR_CLOUDFLARE_ACCOUNT_ID>",
    "REQUEST_ANALYTICS_DATASET": "squawk_requests_local",
    "ADSB_PROVIDER_PRIMARY": "https://api.airplanes.live/v2/point/{lat}/{lon}/{radius}",
    "ADSB_PROVIDER_FALLBACK": "https://api.adsb.lol/v2/point/{lat}/{lon}/{radius}",
    "ADSB_PROVIDER_RESERVE": "https://opendata.adsb.fi/api/v2/lat/{lat}/lon/{lon}/dist/{radius}",
    "UPSTREAM_MIN_INTERVAL": "1",
    "UPSTREAM_DAILY_LIMIT": "500",
    "UPSTREAM_MAX_RADIUS_NM": "250"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "squawk-local",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_REQUEST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ADSB_BROKER",
        "class_name": "AdsbBroker"
      }
    ]
  },
  "exports": {
    "AdsbBroker": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "REQUEST_ANALYTICS",
      "dataset": "squawk_requests_local"
    }
  ],
  "send_email": [
    {
      "name": "AUTH_EMAIL"
    },
    {
      "name": "ALERT_EMAIL",
      "destination_address": "<PUT_YOUR_ALERT_INBOX>",
      "allowed_sender_addresses": ["alerts@your-domain.example"]
    }
  ],
  "env": {
    "staging": {
      "vars": {
        "APP_ENV": "staging",
        "FORCE_MODE": "NORMAL",
        "AUTH_FROM_EMAIL": "sign-in@your-domain.example",
        "ALERT_FROM_EMAIL": "alerts@your-domain.example",
        "ADMIN_EMAIL": "admin@your-domain.example",
        "ALERT_RECIPIENT": "<PUT_YOUR_ALERT_INBOX>",
        "PUBLIC_ORIGIN": "https://squawk-staging.example.workers.dev",
        "TURNSTILE_SITE_KEY": "<PUT_YOUR_TURNSTILE_SITE_KEY>",
        "CLOUDFLARE_ACCOUNT_ID": "<PUT_YOUR_CLOUDFLARE_ACCOUNT_ID>",
        "REQUEST_ANALYTICS_DATASET": "squawk_requests_staging",
        "ADSB_PROVIDER_PRIMARY": "https://api.airplanes.live/v2/point/{lat}/{lon}/{radius}",
        "ADSB_PROVIDER_FALLBACK": "https://api.adsb.lol/v2/point/{lat}/{lon}/{radius}",
        "ADSB_PROVIDER_RESERVE": "https://opendata.adsb.fi/api/v2/lat/{lat}/lon/{lon}/dist/{radius}",
        "UPSTREAM_MIN_INTERVAL": "1",
        "UPSTREAM_DAILY_LIMIT": "500",
        "UPSTREAM_MAX_RADIUS_NM": "250"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "squawk-staging",
          "database_id": "<PUT_YOUR_D1_DATABASE_ID>",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "AUTH_REQUEST_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "MISSION_REQUEST_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 12, "period": 60 }
        },
        {
          "name": "ADMIN_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ADSB_BROKER",
            "class_name": "AdsbBroker"
          }
        ]
      },
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_ANALYTICS",
          "dataset": "squawk_requests_staging"
        }
      ],
      "send_email": [
        {
          "name": "AUTH_EMAIL"
        },
        {
          "name": "ALERT_EMAIL",
          "destination_address": "<PUT_YOUR_ALERT_INBOX>",
          "allowed_sender_addresses": ["alerts@your-domain.example"]
        }
      ]
    },
    "production": {
      "routes": [
        {
          "pattern": "your-domain.example",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "FORCE_MODE": "NORMAL",
        "AUTH_FROM_EMAIL": "sign-in@your-domain.example",
        "ALERT_FROM_EMAIL": "alerts@your-domain.example",
        "ADMIN_EMAIL": "admin@your-domain.example",
        "ALERT_RECIPIENT": "<PUT_YOUR_ALERT_INBOX>",
        "PUBLIC_ORIGIN": "https://your-domain.example",
        "ACCESS_TEAM_DOMAIN": "https://your-team.cloudflareaccess.com",
        "ACCESS_AUD": "<PUT_YOUR_ACCESS_AUD>",
        "TURNSTILE_SITE_KEY": "<PUT_YOUR_TURNSTILE_SITE_KEY>",
        "ADSB_PROVIDER_PRIMARY": "https://api.airplanes.live/v2/point/{lat}/{lon}/{radius}",
        "ADSB_PROVIDER_FALLBACK": "https://api.adsb.lol/v2/point/{lat}/{lon}/{radius}",
        "ADSB_PROVIDER_RESERVE": "https://opendata.adsb.fi/api/v2/lat/{lat}/lon/{lon}/dist/{radius}",
        "UPSTREAM_MIN_INTERVAL": "1",
        "UPSTREAM_DAILY_LIMIT": "500",
        "UPSTREAM_MAX_RADIUS_NM": "250",
        "CLOUDFLARE_ACCOUNT_ID": "<PUT_YOUR_CLOUDFLARE_ACCOUNT_ID>",
        "REQUEST_ANALYTICS_DATASET": "squawk_requests_production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "squawk-production",
          "database_id": "<PUT_YOUR_D1_DATABASE_ID>",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "AUTH_REQUEST_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "TRAFFIC_REQUEST_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "MISSION_REQUEST_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 12, "period": 60 }
        },
        {
          "name": "ADMIN_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ADSB_BROKER",
            "class_name": "AdsbBroker"
          }
        ]
      },
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_ANALYTICS",
          "dataset": "squawk_requests_production"
        }
      ],
      "send_email": [
        {
          "name": "AUTH_EMAIL"
        },
        {
          "name": "ALERT_EMAIL",
          "destination_address": "<PUT_YOUR_ALERT_INBOX>",
          "allowed_sender_addresses": ["alerts@your-domain.example"]
        }
      ]
    }
  }
}
