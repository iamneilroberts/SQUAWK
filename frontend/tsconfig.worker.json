{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "worker/**/*.ts",
    "vitest.worker.config.ts",
    "worker-configuration.d.ts"
  ]
}
