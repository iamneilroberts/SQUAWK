{
  "name": "adsb-game-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.0.0",
  "scripts": {
    "predev": "bash scripts/copy-cesium-assets.sh",
    "predev:worker": "bash scripts/copy-cesium-assets.sh",
    "prebuild": "bash scripts/copy-cesium-assets.sh",
    "postbuild": "node scripts/generate-sw-assets.mjs",
    "dev": "vite --mode legacy",
    "dev:worker": "vite dev",
    "build": "npm run typecheck && vite build",
    "deploy:staging": "CLOUDFLARE_ENV=staging npm run build && wrangler deploy",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:routing": "npm run build && ROUTING_TEST=1 vitest run",
    "check:airport-data": "node ../scripts/generate-ourairports.mjs --validate public/data/airports/oa-2026-08-10-v1/manifest.json",
    "types": "wrangler types worker-configuration.d.ts --env-interface WorkerEnv",
    "types:check": "wrangler types worker-configuration.d.ts --env-interface WorkerEnv --check",
    "typecheck:app": "tsc --noEmit",
    "typecheck:worker": "tsc --project tsconfig.worker.json",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker",
    "lint": "eslint src worker vite.config.ts vitest.worker.config.ts --max-warnings 8",
    "check": "npm run check:airport-data && npm run test:unit && npm run test:worker && npm run types:check && npm run lint && npm run test:routing"
  },
  "dependencies": {
    "cesium": "^1.124.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@eslint/js": "9.39.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.55.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
